{
	"name": "nucleo-portais",
	"private": true,
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"format": "biome format --write .",
		"check": "node scripts/check-text-integrity.mjs && node packages/tokens/scripts/validate-tokens.mjs && node scripts/check-storybook-brands.mjs && pnpm test:distribution && pnpm check:packages && biome check .",
		"test:distribution": "node --test scripts/package-distribution.test.mjs",
		"check:packages": "node scripts/gen-dist-exports.mjs --check packages/ui/package.json packages/blocks/package.json",
		"storybook": "pnpm --filter @nucleo/storybook storybook",
		"build:storybook": "pnpm --filter @nucleo/storybook build-storybook",
		"changeset": "changeset",
		"check:integrity": "node scripts/check-text-integrity.mjs",
		"check:pureza": "node scripts/check-purity.mjs",
		"test:storybook": "pnpm --filter @nucleo/storybook test-storybook",
		"chromatic": "pnpm --filter @nucleo/storybook chromatic",
		"pack:all": "pnpm --filter ./packages/tokens --filter ./packages/ui --filter ./packages/blocks exec npm pack",
		"publish:packages": "pnpm --filter ./packages/tokens --filter ./packages/ui --filter ./packages/blocks publish --no-git-checks",
		"check:tokens": "node packages/tokens/scripts/validate-tokens.mjs",
		"check:storybook-brands": "node scripts/check-storybook-brands.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@changesets/cli": "^2.27.10",
		"turbo": "^2.3.3",
		"typescript": "^5.7.3"
	}
}
