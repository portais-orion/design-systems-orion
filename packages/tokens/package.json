{
	"name": "@design-systems-orion/tokens",
	"version": "0.2.0",
	"description": "Tokens semânticos e temas por marca do Design System Orion",
	"sideEffects": ["*.css"],
	"files": ["dist"],
	"scripts": {
		"build": "node ../../scripts/brand-catalog.mjs --check && node scripts/build-tokens.mjs",
		"prepack": "node ../../scripts/brand-catalog.mjs --check && node scripts/build-tokens.mjs"
	},
	"exports": {
		"./brands.json": "./brands.json",
		"./index.css": "./src/index.css",
		"./base.css": "./src/base.css",
		"./themes/supertrans.css": "./src/themes/supertrans.css",
		"./themes/aurora.css": "./src/themes/aurora.css",
		"./themes/orion.css": "./src/themes/orion.css"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org",
		"exports": {
			"./brands.json": "./dist/brands.json",
			"./index.css": "./dist/index.css",
			"./base.css": "./dist/base.css",
			"./themes/supertrans.css": "./dist/themes/supertrans.css",
			"./themes/aurora.css": "./dist/themes/aurora.css",
			"./themes/orion.css": "./dist/themes/orion.css"
		}
	}
}
